# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Secrets / local env
.env
.env.*
!.env.example
*.pem
*.key

# Model/runtime caches
.huggingface/
.cache/
*.safetensors
*.bin
*.pt
*.pth

# Public datasets are reproducibly downloaded; do not commit raw copies
/data/external/synur/*
/data/external/mts_dialog/*
!/data/external/synur/.gitkeep
!/data/external/mts_dialog/.gitkeep

# Experiment outputs and logs
/experiments/llm_baselines/*
!/experiments/llm_baselines/.gitkeep
/logs/*
!/logs/.gitkeep

# Local graph indexes
.codegraph/
graphify-out/
.graphify_detect.json

# IDE / OS
.DS_Store
.idea/
.vscode/

# Upstream working trees are git submodules after initialization
